d\u0430 \u043d\u0430\u0448\u0435\u0439 \u043f\u043e\u043c\u043e\u0439\u043a\u0435 \u0432 \u0441\u043d\u0442... \u041a\u0442\u043e \u0438\u0445 \u0442\u0443\u0434\u0430 \u043f\u043e\u0434\u043a\u0438\u043d\u0443\u043b \u0442\u0430\u043a \u0438 \u043e\u0441\u0442\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u0433\u0430\u0434\u043a\u043e\u0439, \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0432\u0437\u044f\u043b \u0438\u0445 \u043a\u0440\u043e\u043c\u0435 \u043c\u0435\u043d\u044f. \u0421\u0435\u0439\u0447\u0430\u0441 \u0438\u043c 3 \u043c\u0435\u0441. \u041e\u043d\u0438 \u0441\u0442\u0430\u043b\u0438 \u043a\u0440\u0430\u0441\u0430\u0432\u0446\u0430\u043c\u0438 \u0438 \u0443\u0436\u0435 \u0432\u0435\u0441\u044f\u0442 \u043f\u043e 6 \u043a\u0433\ud83d\ude44. \u042f \u0434\u0443\u043c\u0430\u044e \u043e\u043d\u0438 \u0431\u0443\u0434\u0443\u0442 \u0441\u0440\u0435\u0434\u043d\u0438\u043c\u0438 \u0441\u043e\u0431\u0430\u0447\u043a\u0430\u043c\u0438, 55\u0441\u043c \u0432 \u0445\u043e\u043b\u043a\u0435 \u0438 \u0432\u0435\u0441\u043e\u043c \u0434\u043e 20\u043a\u0433. \u0412 \u0442\u0438\u043f\u0435 \u0431\u0435\u043b\u0438\u0433\u0438\u0439\u0441\u043a\u043e\u0439 \u043e\u0432\u0447\u0430\u0440\u043a\u0438 - \u043f\u043e\u0434\u0436\u0430\u0440\u044b\u0435 \u0438 \u043d\u0435 \u0448\u0438\u0440\u043e\u043a\u0438\u0435. \u0423\u0436\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u0447\u0435\u043d\u044c \u0443\u043c\u043d\u044b\u0435, \u043f\u043e\u043d\u044f\u0442\u043b\u0438\u0432\u044b\u0435 \u0434\u0435\u0442\u043a\u0438, \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043d\u0435\u0434\u043e\u0432\u0435\u0440\u0447\u0438\u0432\u044b\u0435 \u043a \u0447\u0443\u0436\u0438\u043c \u0438 \u043e\u0447\u0435\u043d\u044c \u043b\u0430\u0441\u043a\u043e\u0432\u044b\u0435 \u0441\u043e \u0437\u043d\u0430\u043a\u043e\u043c\u044b\u043c\u0438. 3 \u0440\u044b\u0436\u0438\u0445 \u0434\u0435\u0432\u0438\u0446\u044b \u0438 5 \u043c\u0430\u043b\u044c\u0447\u0438\u043a\u043e\u0432,