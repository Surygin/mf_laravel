2f1","id":"2502148063260192v"},{"type":103,"width":480,"height":480,"url":"https://scontent-iev1-1.cdninstagram.com/v/t50.16885-16/271285382_502483944434722_5114259371002700495_n.mp4?efg=eyJ2ZW5jb2RlX3RhZyI6InZ0c192b2RfdXJsZ2VuLjQ4MC5pZ3R2LmJhc2VsaW5lIiwicWVfZ3JvdXBzIjoiW1wiaWdfd2ViX2RlbGl2ZXJ5X3Z0c19vdGZcIl0ifQ\u0026_nc_ht=scontent-iev1-1.cdninstagram.com\u0026_nc_cat=110\u0026_nc_ohc=M9kmJcIBPo4AX_Agi0B\u0026edm=AIQHJ4wBAAAA\u0026vs=2502148063260192_1146409285\u0026_nc_vs=HBksFQAYJEdJWjhLeEFpYkFPcEFja0JBTThpMUNuTmYtbEdidlZCQUFBRhUAAsgBABUAGCRHRks2S3hEb2pnWTFYS2NCQU1va2lyWUxEdTlKYnZWQkFBQUYVAgLIAQAoABgAGwGIB3VzZV9vaWwBMRUAACb%2B5oDE9YHVPxUCKAJDMywXQE6EOVgQYk4YEmRhc2hfYmFzZWxpbmVfMl92MREAdewHAA%3D%3D\u0026_nc_rid=6aa341d934\u0026ccb=7-4\u0026oe=61D71C2C\u0026oh=00_AT_05Vg3ZWqdmvemECWLRPKL-_Rb_iDpaWGPb_kyBR905g\u0026_nc_sid=7b02f1","id":"2502148063260192v"}],"has_audio":true,"video_duration":61.092,"view_count":49842,"caption":{"pk":17919156803051210,"user_id":3054826302,"text":"\u041d\u0430 \u0437\u0430\u043f\u0430\u0434\u0435 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\u0430 \u0438\u0437-\u0437\u0430 \u0440\u043e\u0441\u0442\u0430 \u0446\u0435\u043d \u043d\u0430 \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0439 \u0433\u0430\u0437 \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u044b, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u0441\u043a\u043e\u0440\u0435 \u043e\u0445\u0432\u0430\u0442\u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0440\u0435\u0433\u0438\u043e\u043d\u044b \u0441\u0442\u0440\u0430\u043d\u044b \u0443\u0436\u0435 \u043f\u043e\u0441\u043b\u0435 \u043e\u0431\u0435\u0449\u0430\u043d\u0438\u044f \u0441\u043d\u0438\u0437\u0438\u0442\u044c \u0446\u0435\u043d\u044b.\n\n\u041f\u0440\u0435\u0437\u0438\u0434\u0435\u043d\u0442 \u041a\u0430\u0437\u0430\u0445\u0441\u0442\u0430\u043d\u0430 \u041a\u0430\u0441\u044b\u043c-\u0416\u043e\u043c\u0430\u0440\u0442 \u0422\u043e\u043a\u0430\u0435\u0432 \u043f\u043e\u0434\u043f\u0438\u0441\u0430\u043b \u0443\u043a\u0430\u0437\u044b \u043e \u0432\u0432\u0435\u0434\u0435\u043d\u0438\u0438 \u0447\u0440\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0432 \u041c\u0430\u043d\u0433\u0438\u0441\u0442\u0430\u0443\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0438 \u0410\u043b\u043c\u0430\u0442\u044b.\n\n1 \u044f\u043d\u0432\u0430\u0440\u044f \u0433\u0430\u0437 \u043f\u043e\u0434\u043e\u0440\u043e\u0436\u0430\u043b \u0441 60 \u0442\u0435\u043d\u0433\u0435 (\u20bd10,2) \u0434\u043e 120 (\u20bd20,4). \u041f\u043e\u0441\u043b\u0435 \u0434\u0432\u0443\u0445 \u0434\u043d\u0435\u0439 \u043c\u0438\u0442\u0438\u043d\u0433\u043e\u0432 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u044b \u0430\u0432\u0442\u043e\u0437\u0430\u043f\u0440\u0430\u0432\u043e\u043a \u0432 \u041c\u0430\u043d\u0433\u0438\u0441\u0442\u0430\u0443\u0441\u043a\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0441\u043d\u0438\u0437\u0438\u043b\u0438 \u0446\u0435\u043d\u0443 \u0434\u043e 80-90 \u0442\u0435\u043d\u0433\u0435, \u043d\u043e \u043c\u0438\u0442\u0438\u043d\u0433\u0443\u044e\u0449\u0438\u0435 \u043f\u043e\u0441\u0447\u0438\u0442\u0430\u043b\u0438 \u044d\u0442\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u043c. \u041f\u0440\u043e\u0442\u0435\u0441\u0442\u044b \u0442\u0430\u043a\u0436\u0435 \u043d\u0430\u0447\u0430\u043b\u0438\u0441\u044c \u0432 \u041d\u0443\u0440-\u0421\u0443\u043b\u0442\u0430\u043d\u0435, \u041a\u0430\u0440\u0430\u0433\u0430\u043d\u0434\u0435, \u0410\u0442\u044b\u0440\u0430\u0443, \u0423\u0440\u0430\u043b\u044c\u0441\u043a\u0435, \u0422\u0430\u043b\u0434\u044b\u043a\u043e\u0440\u0433\u0430\u043d\u0435, \u041a\u044b\u0437\u044b\u043b\u043e\u0440\u0434\u0435 \u0438 \u0428\u044b\u043c\u043a\u0435\u043d\u0442\u0435.\n\u041d\u0430 \u043f\u043b\u043e\u0449\u0430\u0434\u0438 \u0420\u0435\u0441\u043f\u0443\u0431\u043b\u0438\u043a\u0438 \u0432 \u0410\u043b\u043c\u0430\u0442\u044b \u0441\u0438\u043b\u043e\u0432\u0438\u043a\u0438 \u043d\u0430\u0447\u0430\u043b\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0442\u044c \u0441\u0432\u0435\u0442\u043e\u0448\u0443\u043c\u043e\u0432\u044b\u0435 \u0433\u0440\u0430\u043d\u0430\u0442\u044b \u043f\u0440\u043e\u0442\u0438\u0432 \u043f\u0440\u043e\u0442\u0435\u0441\u0442\u0443\u044e\u0449\u0438\u0445. Sputnik \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442, \u0447\u0442\u043e \u0441\u043e\u0431\u0440\u0430\u0432\u0448\u0438\u0435\u0441\u044f \u043d\u0430\u0447\u0430\u043b\u0438 \u0433\u0440\u043e\u043c\u0438\u0442\u044c \u043f\u043e\u043b\u0438\u0446\u0435\u0439\u0441\u043a\u0438\u0435 \u043c\u0430\u0448\u0438\u043d\u044b \u0438 \u0438\u0437\u0431\u0438\u043b\u0438 \u0441\u043e\u0442\u0440\u0443\u0434\u043d\u0438\u043a\u0430 \u043f\u043e\u043b\u0438\u0446\u0438\u0438. \u0411\u043e\u043b\u044c\u0448\u0438\u043d\u0441\u0442\u0432\u043e \u0434\u0435\u043c\u043e\u043d\u0441\u0442\u0440\u0430\u043d\u0442\u043e\u0432 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0442\u0442\u0435\u0441\u043d\u0438\u0442\u044c \u0441 \u043f\u043b\u043e\u0449\u0430\u0434\u0438.\n\n\u0412 \u0433\u043e\u0440\u043e\u0434\u0435 \u043f\u0435\u0440\u0435\u0441\u0442\u0430\u043b\u0438 \u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u043c\u043e\u0431\u0438\u043b\u044c\u043d\u044b\u0439 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442 \u0438 \u043c\u0435\u0441\u0441\u0435\u043d\u0434\u0436\u0435\u0440\u044b WhatsApp, Telegram \u0438 Signal, \u043f\u0435\u0440\u0438\u043e\u0434\u0438\u0447\u0435\u0441\u043a\u0438 \u043f\u0440\u043e\u043f\u0430\u0434\u0430\u0435\u0442 \u0441\u0432\u044f\u0437\u044c. \u0410\u043d\u0430\u043b\u043e\u0433\u0438\u0447\u043d\u0430\u044f \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044f \u0432 \u041d\u0443\u0440-\u0421\u0443\u043b\u0442\u0430\u043d\u0435.\n\n\u0412\u043b\u0430\u0441\u0442\u0438 \u0441\